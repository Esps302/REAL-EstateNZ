rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'sanjay00002023@gmail.com' ||
        request.auth.token.email == 'realestatenz01@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
        ))
      );
    }
    
    match /properties/{propertyId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.ownerId == request.auth.uid || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['averageRating', 'reviewCount'])
      );
      allow delete: if isAuthenticated() && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }
    
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        isAdmin() ||
        request.auth.uid == userId || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['averageRating', 'reviewCount'])
      );
      allow delete: if isAuthenticated() && (isAdmin() || request.auth.uid == userId);
    }
    
    match /wallets/{walletId} {
      allow read: if isAuthenticated() && (isAdmin() || request.auth.uid == walletId);
      allow write: if isAuthenticated() && (isAdmin() || request.auth.uid == walletId);
    }
    
    match /credit_transactions/{txId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow write: if isAuthenticated() && (isAdmin() || request.resource.data.userId == request.auth.uid);
    }
    
    match /wallet_transactions/{txId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow write: if isAuthenticated() && (isAdmin() || request.resource.data.userId == request.auth.uid);
    }
    
    match /property_deposits/{depositId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }
    
    match /service_payments/{paymentId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }
    
    match /notifications/{notificationId} {
      // Users can read their own notifications, admins can read all
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      // Users can update their own notifications, admins can create/update, AND anyone can create a notification for admin_system
      allow write: if isAuthenticated() && (
        isAdmin() || 
        (request.resource.data.userId == request.auth.uid) ||
        (request.resource.data.userId == 'admin_system')
      );
    }
    
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.reviewerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (isAdmin() || resource.data.reviewerId == request.auth.uid);
    }
    
    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }
    
    match /leads/{leadId} {
      // Anyone (guests/authenticated users) can submit a lead inquiry
      allow create: if true;
      // Only admins can view, update or delete CRM leads
      allow read, update, delete: if isAdmin();
    }
    
    match /settings/{settingId} {
      // Public site settings like broker info are viewable by everyone
      allow read: if true;
      // Only admins can modify site settings
      allow write: if isAdmin();
    }
    
    match /viewings/{viewingId} {
      allow create: if true;
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid ||
        (request.auth.token.email != null && resource.data.email == request.auth.token.email)
      );
      allow update, delete: if isAdmin();
    }
    
    match /offers/{offerId} {
      allow create: if isAuthenticated() && request.resource.data.buyerId == request.auth.uid;
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.buyerId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        isAdmin() || 
        resource.data.buyerId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid
      );
      allow delete: if isAdmin();
    }
    
    match /mortgages/{id} {
      allow create: if true;
      allow read, write: if isAdmin();
    }
    
    match /solicitors/{id} {
      allow create: if true;
      allow read, write: if isAdmin();
    }
    
    match /conversations/{conversationId} {
      allow read, write: if isAuthenticated() && (
        isAdmin() || 
        resource.data.participants.hasAny([request.auth.uid]) ||
        request.resource.data.participants.hasAny([request.auth.uid])
      );
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }
    
    match /properties/{propertyId}/bids/{bidId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.bidderId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

